@model List<KMC.EventClient.Models.EventModel>

@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int total = Model?.Count ?? 0;
    int totalRegistrations = Model?.Sum(e => e.ParticipantCount) ?? 0;
    int upcoming = Model?.Count(e => e.Date >= DateTime.Now) ?? 0;
}

<div class="container py-4">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1"><i class="fas fa-shield-alt me-2" style="color:#2e5bff;"></i>My Dashboard</h1>
            <p class="text-muted mb-0">Manage the events you have created - edit details or view registrations.</p>
        </div>
        <a href="@Url.Action("Create", "Events")" class="btn btn-lg fw-semibold rounded-3 shadow-sm px-4 py-2" style="background: linear-gradient(135deg, #0a2540 0%, #2e5bff 100%); color: white; border: none;">
            <i class="fas fa-plus-circle me-2"></i>Create New Event
        </a>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="p-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #0a2540 0%, #2e5bff 100%);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-semibold" style="opacity:0.8;">Total Events</div>
                        <div class="fs-1 fw-bold">@total</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width:56px; height:56px; background: rgba(255,255,255,0.15);">
                        <i class="fas fa-calendar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded-4 shadow-sm" style="background-color:#ffffff;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-semibold text-muted">Upcoming Events</div>
                        <div class="fs-1 fw-bold" style="color:#fd7e14;">@upcoming</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width:56px; height:56px; background: #fff3e0;">
                        <i class="fas fa-hourglass-half fs-4" style="color:#fd7e14;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded-4 shadow-sm" style="background-color:#ffffff;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-semibold text-muted">Total Registrations</div>
                        <div class="fs-1 fw-bold" style="color:#198754;">@totalRegistrations</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width:56px; height:56px; background: #e6f4ea;">
                        <i class="fas fa-users fs-4" style="color:#198754;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model is null || Model.Count == 0)
    {
        <div class="text-center py-5 rounded-4 shadow-sm" style="background-color: #ffffff;">
            <i class="fas fa-inbox text-muted mb-3" style="font-size: 60px;"></i>
            <h4 class="text-dark fw-semibold">No Events Created Yet</h4>
            <p class="text-muted px-3 mb-4">You have not created any events yet. Get started by creating your first event!</p>
            <a href="@Url.Action("Create", "Events")" class="btn btn-lg fw-bold rounded-3 px-5 py-2" style="background: linear-gradient(135deg, #0a2540 0%, #2e5bff 100%); color: white; border: none;">
                <i class="fas fa-rocket me-2"></i>Create Your First Event
            </a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: #ffffff;">
            <div class="p-4 pb-0">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-list me-2"></i>My Events</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="my-events-thead">
                        <tr>
                            <th class="py-3 ps-4">Event Details</th>
                            <th class="py-3">Type</th>
                            <th class="py-3">Date &amp; Time</th>
                            <th class="py-3">Location</th>
                            <th class="py-3">Registrations</th>
                            <th class="py-3 pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var eventItem in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">@(eventItem.Title ?? "Untitled Event")</div>
                                    <div class="text-muted small" style="max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@(eventItem.Description ?? "")</div>
                                </td>
                                <td><span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color:#e2e8f0; color:#4a5568;">@(eventItem.EventType ?? "Event")</span></td>
                                <td class="text-muted">@eventItem.Date.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td class="text-muted">@(eventItem.Location ?? "-")</td>
                                <td class="text-muted">@eventItem.ParticipantCount / @eventItem.MaxParticipants</td>
                                <td class="pe-4 text-end">
                                    <a href="@Url.Action("Edit", "Events", new { id = eventItem.Id })" class="btn btn-sm btn-warning fw-semibold text-dark me-1" style="background-color:#ffc107; border:none;">
                                        <i class="fas fa-pencil-alt"></i>
                                    </a>
                                    <a href="@Url.Action("ViewRegistrations", "Events", new { id = eventItem.Id })" class="btn btn-sm btn-outline-navy me-1">
                                        <i class="fas fa-users"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@eventItem.Id">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @foreach (var eventItem in Model)
        {
            <div class="modal fade" id="deleteModal-@eventItem.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="modal-header bg-danger text-white py-3">
                            <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Delete Event</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="mb-2">Are you sure you want to delete <strong>@(eventItem.Title ?? "this event")</strong>?</p>
                            <p class="text-muted small mb-0">This action is permanent and cannot be undone. All registrations for this event will also be deleted.</p>
                        </div>
                        <div class="modal-footer bg-light border-0 py-3">
                            <button type="button" class="btn btn-secondary px-4 rounded-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                            <form asp-action="Delete" asp-route-id="@eventItem.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger px-4 rounded-3 fw-semibold">Delete Event</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .my-events-thead th {
        background-color: #0a2540 !important;
        color: #ffffff !important;
        border-color: #0a2540 !important;
        vertical-align: middle;
    }

    .btn-outline-navy {
        background-color: #ffffff;
        border: 2px solid #0a2540;
        color: #0a2540;
        transition: all 0.2s ease;
    }

        .btn-outline-navy:hover {
            background-color: #0a2540;
            color: #ffffff;
            border-color: #0a2540;
        }
</style>
</style>