@model KMC.EventClient.Models.ProtocolModel

@{
    ViewData["Title"] = "KMC Protocol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Protocol - KMC Events</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background-image: url('/images/bg-building.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .protocol-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 40px 35px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.25);
        }

        .logo-section {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 20px;
        }

            .logo-section img {
                height: 55px;
                width: auto;
            }

        .logo-text h2 {
            color: #0a2540;
            font-weight: 700;
            font-size: 24px;
            margin: 0;
            line-height: 1.2;
        }

        .logo-text p {
            color: #555;
            font-size: 13px;
            font-weight: 400;
            margin: 0;
        }

        .logo-icon-fallback {
            font-size: 40px;
            color: #0a2540;
        }

        .protocol-title {
            text-align: center;
            color: #0a2540;
            font-weight: 600;
            font-size: 18px;
            margin-bottom: 15px;
        }

        .protocol-content {
            background: #f8f9fa;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            max-height: 180px;
            overflow-y: auto;
            font-size: 13px;
            color: #444;
            line-height: 1.6;
        }

            .protocol-content ul {
                padding-left: 20px;
                margin-bottom: 0;
            }

                .protocol-content ul li {
                    margin-bottom: 6px;
                }

        .form-label {
            color: #0a2540;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 6px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 15px;
        }

            .input-group-custom .input-icon {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #8898aa;
                font-size: 16px;
                z-index: 2;
            }

            .input-group-custom input {
                width: 100%;
                padding: 14px 15px 14px 45px;
                background: #f0f4f8;
                border: 2px solid #e2e8f0;
                border-radius: 10px;
                font-size: 14px;
                color: #333;
                transition: all 0.3s ease;
            }

                .input-group-custom input:focus {
                    outline: none;
                    border-color: #0a2540;
                    background: #ffffff;
                    box-shadow: 0 0 0 4px rgba(10, 37, 64, 0.1);
                }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            font-size: 14px;
            color: #555;
        }

            .checkbox-group input[type="checkbox"] {
                width: 18px;
                height: 18px;
                accent-color: #0a2540;
                cursor: pointer;
            }

            .checkbox-group label {
                cursor: pointer;
                margin: 0;
            }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: #0a2540;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            color: #ffffff;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .btn-submit:hover {
                background: #1a365d;
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(10, 37, 64, 0.3);
            }

        .protocol-card a {
            color: #0a2540;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: 0.3s;
        }

            .protocol-card a:hover {
                text-decoration: underline;
                color: #1a365d;
            }

        .alert-custom {
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 13px;
            border: none;
            margin-bottom: 15px;
        }

        .alert-danger {
            background: #fff5f5;
            color: #c0392b;
            border: 1px solid #fed7d7;
        }

        .alert-success {
            background: #f0fff4;
            color: #27ae60;
            border: 1px solid #c6f6d5;
        }

        .divider {
            border-color: #e2e8f0;
            margin: 20px 0;
        }

        .footer-text {
            text-align: center;
            color: #8898aa;
            font-size: 11px;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <div class="protocol-card">
        <div class="logo-section">
            <img src="/images/logo.png" alt="KMC Logo" onerror="this.style.display='none'; document.getElementById('fallbackIcon').style.display='block';" />
            <i id="fallbackIcon" class="fas fa-landmark logo-icon-fallback" style="display:none;"></i>

            <div class="logo-text">
                <h2>KMC EVENTS</h2>
                <p>Kandy Municipal Council</p>
            </div>
        </div>

        <div class="protocol-title">
            <i class="fas fa-file-contract me-2"></i> KMC Protocol Agreement
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-custom alert-danger">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-custom alert-success">@TempData["SuccessMessage"]</div>
        }

        <form asp-action="Protocol" method="post">
            @Html.AntiForgeryToken()

          
            <div class="protocol-content">
                <strong>KMC Protocol Rules & Guidelines:</strong>
                <ul>
                    <li>All events must follow KMC municipal policies.</li>
                    <li>User data will be kept confidential and secure.</li>
                    <li>Any misuse of the platform will result in account suspension.</li>
                    <li>Users must adhere to the code of conduct during events.</li>
                    <li>Please report any technical issues to the admin team.</li>
                </ul>
            </div>

          
            <div>
                <label asp-for="FullName" class="form-label">Full Name (Signature)</label>
                <div class="input-group-custom">
                    <i class="fas fa-signature input-icon"></i>
                    <input asp-for="FullName" placeholder="Enter your full name to agree" />
                </div>
                <span asp-validation-for="FullName" class="text-danger" style="font-size:12px;"></span>
            </div>

           
            <div class="checkbox-group">
                <input type="checkbox" id="agreeCheck" name="AgreeToTerms" value="true" />
                <label for="agreeCheck">I have read and agree to the KMC Protocol rules.</label>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fas fa-check-circle me-2"></i> Accept & Continue
            </button>
        </form>

        <hr class="divider" />
        <div class="text-center">
            <span style="color: #555; font-size: 14px;">Already accepted?</span>
            <a asp-action="Login">Login here</a>
        </div>

        <div class="footer-text">
            © 2026 Kandy Municipal Council | All Rights Reserved
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>