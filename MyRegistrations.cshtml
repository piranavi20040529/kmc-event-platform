@model IEnumerable<KMC.EventClient.Models.EventModel>

@{
    ViewData["Title"] = "My Registrations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
  
    <div class="mb-5">
        <h1 class="fw-bold text-dark mb-1">🎫 My Registrations</h1>
        <p class="text-muted">Review the events you have registered to attend. Show up with your ticket details.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 rounded-4 shadow-sm" style="background-color: #ffffff;">
            <i class="fas fa-ticket-alt text-muted mb-3" style="font-size: 60px; transform: rotate(-45deg);"></i>
            <h4 class="text-dark fw-semibold">No Registered Events</h4>
            <p class="text-muted px-3 mb-4">You have not registered for any events yet. Check out the public events page to register!</p>
            <a href="@Url.Action("Index", "Events")" class="btn btn-dark px-4 py-2 rounded-3" style="background-color: #0a2540;">
                Browse Public Events
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: #ffffff;">
                        
                        <div class="bg-light py-3 px-4 d-flex justify-content-between align-items-center" style="border-bottom: 1px solid #f0f4f8;">
                            <span class="small fw-semibold text-muted">
                                <i class="fas fa-ticket-alt me-1 text-primary" style="color: #2e5bff !important;"></i> Registered ticket
                            </span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold small">
                                Valid
                            </span>
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <h4 class="card-title fw-bold text-dark mb-2">@item.Title</h4>
                            <p class="card-text text-muted mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 14px; line-height: 1.6;">
                                @item.Description
                            </p>

                            <div class="small text-muted mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="far fa-calendar-alt text-primary me-2" style="color: #2e5bff !important; width: 16px;"></i>
                                    <span>@item.Date.ToString("dd MMM yyyy, hh:mm tt")</span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-map-marker-alt text-danger me-2" style="width: 16px;"></i>
                                    <span>@item.Location</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-user-tie text-secondary me-2" style="width: 16px;"></i>
                                    <span>Host: <strong>@item.OrganizerName</strong></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>