@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof openCustomModal === 'function') {
                openCustomModal({
                    title: 'Success',
                messagePrimary: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"]?.ToString() ?? string.Empty))',
                    type: 'success',
                    showCancel: false,
                    confirmText: 'OK'
                });
            }
        });
    </script>
}

