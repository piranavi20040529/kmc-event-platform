@model KMC.EventClient.Models.ForgotPasswordModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - KMC Events</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background-image: url('/images/bg-building.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .forgot-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 40px 35px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.25);
        }

        .logo-section {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 25px;
        }

            .logo-section img {
                height: 60px;
                width: auto;
            }

        .logo-text h2 {
            color: #0a2540;
            font-weight: 700;
            font-size: 26px;
            margin: 0;
            line-height: 1.2;
        }

        .logo-text p {
            color: #555;
            font-size: 13px;
            font-weight: 400;
            margin: 0;
        }

        .logo-icon-fallback {
            font-size: 45px;
            color: #0a2540;
        }

        .subtitle-text {
            text-align: center;
            color: #666;
            font-size: 14px;
            margin-bottom: 25px;
            line-height: 1.5;
        }

        .form-label {
            color: #0a2540;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 6px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

            .input-group-custom .input-icon {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #8898aa;
                font-size: 16px;
                z-index: 2;
            }

            .input-group-custom input {
                width: 100%;
                padding: 14px 15px 14px 45px;
                background: #f0f4f8;
                border: 2px solid #e2e8f0;
                border-radius: 10px;
                font-size: 14px;
                color: #333;
                transition: all 0.3s ease;
            }

                .input-group-custom input::placeholder {
                    color: #a0aec0;
                }

                .input-group-custom input:focus {
                    outline: none;
                    border-color: #0a2540;
                    background: #ffffff;
                    box-shadow: 0 0 0 4px rgba(10, 37, 64, 0.1);
                }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: #0a2540;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            color: #ffffff;
            transition: all 0.3s ease;
            cursor: pointer;
            margin-top: 5px;
        }

            .btn-submit:hover {
                background: #1a365d;
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(10, 37, 64, 0.3);
            }

        .forgot-card a {
            color: #0a2540;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: 0.3s;
        }

            .forgot-card a:hover {
                text-decoration: underline;
                color: #1a365d;
            }

        .alert-custom {
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 13px;
            border: none;
            margin-bottom: 20px;
        }

        .alert-danger {
            background: #fff5f5;
            color: #c0392b;
            border: 1px solid #fed7d7;
        }

        .alert-success {
            background: #f0fff4;
            color: #27ae60;
            border: 1px solid #c6f6d5;
        }

        .custom-modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 99999;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .custom-modal-card {
            background: #ffffff;
            border-radius: 20px;
            max-width: 480px;
            width: 100%;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            animation: modalFadeIn 0.3s ease-out;
            border: none;
        }

        .custom-modal-header {
            padding: 18px 24px;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 1.2rem;
            font-weight: 600;
        }

        .custom-modal-header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .custom-modal-header-left i {
                font-size: 1.3rem;
            }

        .custom-modal-body {
            padding: 28px 24px;
            background: #ffffff;
        }

        .custom-modal-message-primary {
            color: #333333;
            font-weight: 600;
            margin-bottom: 0px;
            font-size: 1.1rem;
            line-height: 1.5;
        }

        .custom-modal-footer {
            padding: 16px 24px;
            background: #ffffff;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            border-top: 1px solid #f0f4f8;
        }

        .custom-modal-btn {
            border-radius: 10px;
            padding: 10px 24px;
            font-weight: 600;
            border: none;
            font-size: 14px;
            transition: opacity 0.2s;
            cursor: pointer;
        }

            .custom-modal-btn:hover {
                opacity: 0.9;
            }

        .custom-modal-btn-confirm {
            background: #0a2540;
            color: #ffffff;
        }

        @@keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .divider {
            border-color: #e2e8f0;
            margin: 20px 0;
        }

        .footer-text {
            text-align: center;
            color: #8898aa;
            font-size: 11px;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <div id="custom-modal-backdrop" class="custom-modal-backdrop">
        <div class="custom-modal-card">
            <div id="custom-modal-header" class="custom-modal-header">
                <div class="custom-modal-header-left">
                    <i id="custom-modal-icon" class="fas fa-exclamation-triangle"></i>
                    <span id="custom-modal-title">Success</span>
                </div>
                <i class="fas fa-times" style="cursor: pointer; opacity: 0.8; font-size: 1.1rem;" onclick="closeCustomModal()"></i>
            </div>
            <div class="custom-modal-body">
                <div id="custom-modal-message-primary" class="custom-modal-message-primary">Message here</div>
            </div>
            <div class="custom-modal-footer">
                <button id="custom-modal-btn-confirm" class="custom-modal-btn custom-modal-btn-confirm" onclick="closeCustomModal()">OK</button>
            </div>
        </div>
    </div>

    <div class="forgot-card">
        <div class="logo-section">
            <img src="/images/building-logo.jpg" alt="KMC Logo" onerror="this.style.display='none'; document.getElementById('fallbackIcon').style.display='block';" />
            <i id="fallbackIcon" class="fas fa-landmark logo-icon-fallback" style="display:none;"></i>

            <div class="logo-text">
                <h2>KMC EVENTS</h2>
                <p>Kandy Municipal Council</p>
            </div>
        </div>

        <div class="subtitle-text">
            Enter your email and create a new password to reset your account.
        </div>

     
        <script>
            function openCustomModal(options) {
                var backdrop = document.getElementById('custom-modal-backdrop');
                var header = document.getElementById('custom-modal-header');
                var icon = document.getElementById('custom-modal-icon');
                var title = document.getElementById('custom-modal-title');
                var msgPrimary = document.getElementById('custom-modal-message-primary');
                var btnConfirm = document.getElementById('custom-modal-btn-confirm');

                title.innerText = options.title || 'Notification';
                msgPrimary.innerText = options.messagePrimary || '';

                var headerBg = '#0a2540';
                var iconClass = 'fa-info-circle';
                var confirmBtnBg = '#0a2540';

                if (options.type === 'danger' || options.type === 'error') {
                    headerBg = '#dc3545';
                    iconClass = 'fa-times-circle';
                    confirmBtnBg = '#dc3545';
                } else if (options.type === 'success') {
                    headerBg = '#198754';
                    iconClass = 'fa-check-circle';
                    confirmBtnBg = '#198754';
                } else if (options.type === 'warning') {
                    headerBg = '#fd7e14';
                    iconClass = 'fa-exclamation-triangle';
                    confirmBtnBg = '#fd7e14';
                }

                header.style.backgroundColor = headerBg;
                icon.className = 'fas ' + iconClass;
                btnConfirm.style.backgroundColor = confirmBtnBg;
                btnConfirm.innerText = options.confirmText || 'OK';

                backdrop.style.display = 'flex';
            }

            function closeCustomModal() {
                document.getElementById('custom-modal-backdrop').style.display = 'none';
            }

            document.addEventListener('DOMContentLoaded', function () {
                @if (TempData["SuccessMessage"] != null)
                {
                        <text>
                        openCustomModal({
                            title: 'Success',
                            messagePrimary: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"].ToString()))',
                            type: 'success'
                        });
                        </text>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                        <text>
                        openCustomModal({
                            title: 'Error',
                            messagePrimary: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["ErrorMessage"].ToString()))',
                            type: 'danger'
                        });
                        </text>
                }
            });
        </script>

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

          
            <div>
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-group-custom">
                    <i class="fas fa-envelope input-icon"></i>
                    <input asp-for="Email" placeholder="Enter your registered email" />
                </div>
                <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
            </div>

        
            <div>
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <div class="input-group-custom">
                    <i class="fas fa-lock input-icon"></i>
                    <input asp-for="NewPassword" type="password" placeholder="Enter new password" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger" style="font-size:12px;"></span>
            </div>

    
            <div>
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <div class="input-group-custom">
                    <i class="fas fa-check-circle input-icon"></i>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm new password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fas fa-key me-2"></i> Reset Password
            </button>
        </form>

        <hr class="divider" />
        <div class="text-center">
            <span style="color: #555; font-size: 14px;">Remember your password?</span>
            <a asp-action="Login">Login here</a>
        </div>

        <div class="footer-text">
            Â© 2026 Kandy Municipal Council | All Rights Reserved
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
